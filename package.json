{
  "name": "dodo-adventure",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "phrases": "tsx scripts/extract-phrases.ts",
    "audio": "npm run phrases && python scripts/gen_audio.py",
    "zh:check": "tsx scripts/check-zh.ts",
    "emoji": "tsx scripts/build-emoji.ts && tsx scripts/build-sticker-tones.ts",
    "icons": "node scripts/build-icons.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:toddler": "node tests/toddler/run.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/huninn": "^5.3.1",
    "dexie": "^4.4.7",
    "firebase": "^13.1.0",
    "motion": "^14.7.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
